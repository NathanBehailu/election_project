{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/vote",
      "destination": "/vote.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
